# Copy to .env. Never commit .env or share API keys.
JOHNBER_PORT=8765
JOHNBER_MAX_UPLOAD_MB=4096
JOHNBER_MAX_DURATION_SECONDS=14400
# Optional local model: downloads only after explicit consent in app.
JOHNBER_LOCAL_MODEL=small
# Optional paid provider. Requests require per-job consent in UI.
JOHNBER_API_KEY=
JOHNBER_API_BASE=https://api.openai.com/v1
JOHNBER_CHAT_MODEL=gpt-4.1-mini
JOHNBER_STT_MODEL=whisper-1
# JOHNBER_DATA_DIR=C:\JohnberData
