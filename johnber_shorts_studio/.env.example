# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 Git에 올라가지 않습니다.

# --- 서버 ---
JSS_HOST=127.0.0.1
JSS_PORT=8765
# JSS_DATA_DIR=D:\JohnberStudioData        (기본: 프로그램 폴더\data)
JSS_MAX_UPLOAD_GB=8
JSS_MAX_SOURCE_MINUTES=180

# --- FFmpeg (PATH에 없을 때만 지정) ---
# JSS_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# JSS_FFPROBE=C:\ffmpeg\bin\ffprobe.exe

# --- 로컬 자동 전사 (외부 API 요금 없음) ---
# 모델 이름(tiny/base/small/medium/large-v3) 또는 미리 받은 모델 폴더 경로
JSS_WHISPER_MODEL=small
JSS_WHISPER_DEVICE=cpu
JSS_WHISPER_COMPUTE=int8

# --- AI 구간 추천 (외부 API, 사용량에 따라 요금 발생) ---
# 키가 없으면 AI 추천은 '미연결'로 표시되고 나머지 기능은 그대로 동작합니다.
ANTHROPIC_API_KEY=
JSS_ANTHROPIC_MODEL=claude-opus-5-5
# low / medium / high — 높을수록 사고량·비용 증가
JSS_ANTHROPIC_EFFORT=medium
# 요금 표시용 단가(USD / 100만 토큰). Anthropic 공식 요금표에서 확인해 넣으세요.
# 비워 두면 화면에 '비용 미확인'으로 표시합니다(추정 금액을 지어내지 않음).
JSS_PRICE_INPUT_PER_MTOK=
JSS_PRICE_OUTPUT_PER_MTOK=
